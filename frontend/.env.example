# AuraCast Frontend Environment Configuration

# Adres URL Twojego backendowego API Express (np. https://api.twojadomena.pl)
VITE_API_URL=http://localhost:4000

# Adres URL serwera multimediów HTTP-FLV (np. https://stream.twojadomena.pl)
VITE_MEDIA_URL=http://localhost:8000

# Adres URL serwera WebSockets czatu (domyślnie tożsamy z API)
VITE_WS_URL=http://localhost:4000
