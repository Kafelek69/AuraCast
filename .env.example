# ==============================================================================
# AuraCast Root Deployment Configuration (.env.example)
# Copy this file to .env before deploying with Docker Compose
# ==============================================================================

# --- DATABASE (MySQL 8.0) ---
MYSQL_ROOT_PASSWORD=auracast_root_secure_password_change_me
MYSQL_DATABASE=auracast
MYSQL_USER=auracast_user
MYSQL_PASSWORD=auracast_secure_devpassword_123!
DB_PORT=3306

# --- BACKEND (API, WebSockets, RTMP) ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=*
JWT_SECRET=auracast_super_secret_jwt_key_please_change_in_production_2026_xyz
RTMP_PORT=1935
HTTP_MEDIA_PORT=8000

# --- FRONTEND (React 19 + Vite + Nginx) ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000
VITE_MEDIA_URL=http://localhost:8000
VITE_WS_URL=http://localhost:4000
